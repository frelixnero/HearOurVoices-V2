// HearOURVOICES — Prisma schema (source of truth: docs/HEAROURVOICES_MASTER_SPEC.md §28)
// PostgreSQL relational core (§28), object storage for files (§14), search later (§27).
//
// Conventions:
// - Every privileged mutation is recorded in AuditLog (§28.11, §4.6) — append-only.
// - Enums encode the spec's controlled vocabularies so labels can't drift (§13, §23, §9.3).
// - NOTE (DB gap): §28 references `source_id` across many tables but never defines a
//   sources table. We add `Source` + `Citation` (foundation item 5). See docs/gap-analysis.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// 28.1 IDENTITY AND ACCESS
// ===========================================================================

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  RESTRICTED
  CLOSED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  phone        String?    @unique
  passwordHash String? // null when using external auth (§28.1 external_auth_id)
  externalAuthId String?  @unique
  displayName  String
  publicAlias  String? // approved public alias (§6.3)
  status       UserStatus @default(PENDING)
  mfaSecret    String? // TOTP secret; presence => MFA enabled (§32 privileged MFA)
  emailVerifiedAt DateTime?
  // Community Reports: users qualify as Independent Civic Journalists after a
  // good record (higher-trust publishing lane). Granted, not self-claimed.
  isJournalist Boolean  @default(false)
  // Staff capabilities (granted by an admin). Moderators review the queue and set
  // claim status; admins additionally manage users and grant roles.
  isModerator  Boolean  @default(false)
  isAdmin      Boolean  @default(false)
  locale       String     @default("en-US")
  timezone     String     @default("America/Chicago")
  createdAt    DateTime   @default(now())
  lastLoginAt  DateTime?

  profile        UserProfile?
  verifications  IdentityVerification[]
  roles          UserRole[]
  sessions       Session[]
  reputationEvents ReputationEvent[]

  @@index([status])
}

model UserProfile {
  userId               String  @id
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  biography            String?
  homeJurisdictionId   String?
  homeJurisdiction     Jurisdiction? @relation(fields: [homeJurisdictionId], references: [id])
  // Never publish precise address (§8.1, §33). Only the level a user opts into.
  publicLocationLevel  String  @default("none") // none|city|county|district|state
  profileImageUrl      String?
  interests            String[] @default([])
  notificationPreferences Json  @default("{}")
}

enum VerificationStatus {
  STARTED
  PENDING_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

model IdentityVerification {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationType    String // email|phone|residency|gov_id|official_office
  provider            String?
  status              VerificationStatus @default(STARTED)
  verifiedName        String?
  verifiedJurisdiction String?
  completedAt         DateTime?
  expiresAt           DateTime?
  encryptedReference  String? // high-risk data — store only an encrypted pointer (§32)
  createdAt           DateTime @default(now())

  @@index([userId])
  @@index([status])
}

// Role is a named capability set; assignment can be global or scoped (§29).
model Role {
  id          String     @id @default(cuid())
  name        String     @unique // matches RoleName enum values in code
  description String
  assignments UserRole[]
}

enum RoleScopeType {
  GLOBAL
  JURISDICTION
  INVESTIGATION
  CAMPAIGN
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  scopeType RoleScopeType @default(GLOBAL)
  scopeId   String? // e.g. jurisdiction id when scopeType=JURISDICTION
  grantedBy String?
  grantedAt DateTime @default(now())
  revokedAt DateTime?

  @@unique([userId, roleId, scopeType, scopeId])
  @@index([userId])
  @@index([roleId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique // we store only a hash of the session token (§32)
  deviceId  String?
  ipHash    String? // peppered hash, never raw IP (§28.1, §33)
  riskScore Int      @default(0) // bot-risk signal (§22)
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// ===========================================================================
// 28.2 GOVERNMENT STRUCTURE
// ===========================================================================

model Jurisdiction {
  id                String   @id @default(cuid())
  name              String
  type              String // city|county|school_district|state|congressional_district|...
  parentId          String?
  parent            Jurisdiction?  @relation("JurisdictionTree", fields: [parentId], references: [id])
  children          Jurisdiction[] @relation("JurisdictionTree")
  stateCode         String?
  countryCode       String   @default("US")
  boundaryReference String?
  officialWebsite   String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  governmentBodies GovernmentBody[]
  agencies         Agency[]
  offices          Office[]
  courts           Court[]
  profiles         UserProfile[]

  @@index([parentId])
  @@index([type])
}

model GovernmentBody {
  id             String  @id @default(cuid())
  jurisdictionId String
  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id])
  name           String
  type           String
  officialWebsite String?
  measures       Measure[]

  @@index([jurisdictionId])
}

model Agency {
  id             String  @id @default(cuid())
  jurisdictionId String
  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id])
  governmentBodyId String?
  name           String
  type           String?
  description    String?
  officialWebsite String?
  status         String  @default("active")
  createdAt      DateTime @default(now())

  offices        Office[]

  @@index([jurisdictionId])
}

model Office {
  id                String  @id @default(cuid())
  jurisdictionId    String
  jurisdiction      Jurisdiction @relation(fields: [jurisdictionId], references: [id])
  agencyId          String?
  agency            Agency? @relation(fields: [agencyId], references: [id])
  title             String
  officeType        String
  electedOrAppointed String // elected|appointed
  terms             OfficeTerm[]

  @@index([jurisdictionId])
}

// A real-world person (official, judge, etc.). Demo data must be fictional (§44).
model Person {
  id                 String  @id @default(cuid())
  fullName           String
  dateOfBirthPublic  DateTime?
  biography          String?
  publicSource       String?
  createdAt          DateTime @default(now())

  officeTerms        OfficeTerm[]
  promises           Promise[]
  votes              Vote[]
  statements         OfficialStatement[]
  conflicts          Conflict[]
  judgeRoles         Judge[]
  prosecutorRoles    Prosecutor[]
}

model OfficeTerm {
  id                String   @id @default(cuid())
  officeId          String
  office            Office   @relation(fields: [officeId], references: [id])
  personId          String
  person            Person   @relation(fields: [personId], references: [id])
  startDate         DateTime
  endDate           DateTime?
  appointmentSource String?
  status            String   @default("active")
  promises          Promise[]

  @@index([officeId])
  @@index([personId])
}

// ===========================================================================
// SOURCES & CITATIONS (foundation item 5) — ADDED, not in §28 explicitly.
// Everything factual points at a Source; Citation is a polymorphic link so any
// record (promise, vote, claim, event...) can cite one or more sources (§4.1).
// ===========================================================================

enum SourceType {
  OFFICIAL_RECORD
  COURT_FILING
  MEETING_RECORD
  NEWS_REPORT
  ACADEMIC_STUDY
  DATASET
  OFFICIAL_STATEMENT
  PUBLIC_WEBPAGE
  FOIA_PRODUCTION
  OTHER
}

enum SourceQuality {
  PRIMARY_OFFICIAL
  SECONDARY_RELIABLE
  UNVERIFIED
  DISPUTED
}

model Source {
  id          String     @id @default(cuid())
  title       String
  sourceType  SourceType
  quality     SourceQuality @default(UNVERIFIED)
  publisher   String?
  url         String?
  publishedAt DateTime?
  retrievedAt DateTime?
  description String?
  evidenceId  String? // optional link to a stored EvidenceItem copy of the source
  evidence    EvidenceItem? @relation(fields: [evidenceId], references: [id])
  addedByUserId String?
  createdAt   DateTime   @default(now())

  citations   Citation[]

  @@index([sourceType])
}

model Citation {
  id         String   @id @default(cuid())
  sourceId   String
  source     Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  // Polymorphic subject: which record this citation supports.
  subjectType String // promise|vote|measure|claim|case_event|statement|scorecard_metric|...
  subjectId   String
  locator     String? // page, timestamp, paragraph
  note        String?
  createdAt   DateTime @default(now())

  @@index([subjectType, subjectId])
  @@index([sourceId])
}

// ===========================================================================
// 28.3 OFFICIAL ACCOUNTABILITY
// ===========================================================================

enum PromiseStatus {
  NOT_STARTED
  IN_PROGRESS
  PARTIALLY_COMPLETED
  COMPLETED
  BLOCKED
  REVERSED
  BROKEN
  CANNOT_BE_VERIFIED
  NO_LONGER_APPLICABLE
}

model Promise {
  id             String  @id @default(cuid())
  personId       String
  person         Person  @relation(fields: [personId], references: [id])
  officeTermId   String?
  officeTerm     OfficeTerm? @relation(fields: [officeTermId], references: [id])
  text           String
  category       String?
  madeAt         DateTime?
  deadline       DateTime?
  status         PromiseStatus @default(NOT_STARTED)
  confidence     String  @default("unclear")
  lastReviewedAt DateTime?
  createdAt      DateTime @default(now())

  @@index([personId])
}

model Measure {
  id               String  @id @default(cuid())
  governmentBodyId String
  governmentBody   GovernmentBody @relation(fields: [governmentBodyId], references: [id])
  title            String
  officialNumber   String?
  summary          String?
  introducedAt     DateTime?
  decidedAt        DateTime?
  status           String?
  financialImpact  Decimal?
  votes            Vote[]

  @@index([governmentBodyId])
}

model Vote {
  id        String   @id @default(cuid())
  measureId String
  measure   Measure  @relation(fields: [measureId], references: [id])
  personId  String
  person    Person   @relation(fields: [personId], references: [id])
  voteValue String // yes|no|abstain|absent
  voteDate  DateTime?

  @@index([measureId])
  @@index([personId])
}

model OfficialStatement {
  id            String   @id @default(cuid())
  personId      String?
  person        Person?  @relation(fields: [personId], references: [id])
  agencyId      String?
  text          String
  statementDate DateTime?
  statementType String?
  createdAt     DateTime @default(now())
}

model Conflict {
  id           String   @id @default(cuid())
  personId     String?
  person       Person?  @relation(fields: [personId], references: [id])
  agencyId     String?
  conflictType String
  description  String
  status       String   @default("disclosed")
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
}

model Complaint {
  id            String   @id @default(cuid())
  targetType    String // person|agency|court|...
  targetId      String
  complaintType String
  filedAt       DateTime?
  status        String   @default("filed")
  disposition   String?
  publicSummary String?
  createdAt     DateTime @default(now())

  @@index([targetType, targetId])
}

// ===========================================================================
// 28.4 COURTS AND CASES (Phase 2 surface; modeled now to avoid migration churn)
// ===========================================================================

model Court {
  id             String  @id @default(cuid())
  jurisdictionId String
  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id])
  name           String
  courtType      String?
  level          String?
  officialWebsite String?
  judges         Judge[]
  cases          Case[]
}

model Judge {
  id              String   @id @default(cuid())
  personId        String
  person          Person   @relation(fields: [personId], references: [id])
  courtId         String
  court           Court    @relation(fields: [courtId], references: [id])
  startDate       DateTime?
  endDate         DateTime?
  selectionMethod String?
  status          String   @default("active")
}

model ProsecutorOffice {
  id              String  @id @default(cuid())
  jurisdictionId  String
  name            String
  officialWebsite String?
  prosecutors     Prosecutor[]
}

model Prosecutor {
  id                 String   @id @default(cuid())
  personId           String
  person             Person   @relation(fields: [personId], references: [id])
  prosecutorOfficeId String
  prosecutorOffice   ProsecutorOffice @relation(fields: [prosecutorOfficeId], references: [id])
  startDate          DateTime?
  endDate            DateTime?
  status             String   @default("active")
}

enum CaseVisibility {
  PUBLIC
  PARTIALLY_PUBLIC
  RESTRICTED
  SEALED
  EXPUNGED
  ARCHIVED
  REMOVED
}

model Case {
  id            String   @id @default(cuid())
  courtId       String
  court         Court    @relation(fields: [courtId], references: [id])
  caseNumber    String
  caseType      String?
  filedAt       DateTime?
  closedAt      DateTime?
  status        String?
  publicTitle   String?
  visibility    CaseVisibility @default(PUBLIC)
  sealingStatus String?
  events        CaseEvent[]
  parties       CaseParty[]
  charges       Charge[]
  outcomes      CaseOutcome[]

  @@index([courtId])
}

model CaseParty {
  id             String  @id @default(cuid())
  caseId         String
  case           Case    @relation(fields: [caseId], references: [id])
  personOrOrgType String
  personOrOrgId  String?
  role           String
  publicName     String?
  protected      Boolean @default(false) // victim/minor protection (§12.4)
}

model CaseEvent {
  id                 String   @id @default(cuid())
  caseId             String
  case               Case     @relation(fields: [caseId], references: [id])
  eventType          String
  eventAt            DateTime?
  officialText       String?
  plainSummary       String?
  verificationStatus String   @default("unverified")
  visibility         CaseVisibility @default(PUBLIC)
  redactionStatus    String   @default("none")
  addedByUserId      String?
  reviewedByUserId   String?
  createdAt          DateTime @default(now())

  @@index([caseId])
}

model Charge {
  id          String   @id @default(cuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id])
  statute     String?
  description String?
  level       String?
  filedAt     DateTime?
  outcome     String?
}

model CaseOutcome {
  id          String   @id @default(cuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id])
  outcomeType String
  outcomeDate DateTime?
  sentence    String?
  disposition String?
}

// ===========================================================================
// 28.5 CLAIMS AND EVIDENCE — the core of the platform (§13, §14)
// ===========================================================================

enum ClaimType {
  OBSERVATION
  ALLEGATION
  OFFICIAL_STATEMENT
  STATISTICAL_CLAIM
  LEGAL_CLAIM
  FINANCIAL_CLAIM
  PROMISE
  PREDICTION
  OPINION
  CONCLUSION
  CORRECTION
}

// §13.5 review workflow states. Serious allegations never auto-publish (§45 rule 5).
enum ClaimStatus {
  DRAFT
  SUBMITTED
  AUTO_CHECK
  NEEDS_EVIDENCE
  IN_RESEARCH_REVIEW
  IN_LEGAL_REVIEW
  AWAITING_OFFICIAL_RESPONSE
  PUBLISHED
  RETURNED
  RESTRICTED
  REJECTED
}

enum ConfidenceLabel {
  VERIFIED
  STRONGLY_SUPPORTED
  PARTIALLY_SUPPORTED
  UNCLEAR
  DISPUTED
  UNSUPPORTED
  MISLEADING
  FALSE
  OUTDATED
  CANNOT_BE_VERIFIED
}

enum ContentVisibility {
  PUBLIC
  REGISTERED
  VERIFIED_RESEARCHERS
  INVESTIGATION_TEAM
  MODERATOR_ONLY
  LEGAL_REVIEW_ONLY
  OWNER_ONLY
  SEALED
}

model Claim {
  id             String   @id @default(cuid())
  submitterUserId String
  claimType      ClaimType
  text           String
  targetType     String // person|agency|office|court|case|...
  targetId       String?
  occurredAt     DateTime?
  jurisdictionId String?
  topic          String?
  status         ClaimStatus @default(DRAFT)
  confidenceLabel ConfidenceLabel @default(UNCLEAR)
  visibility     ContentVisibility @default(OWNER_ONLY)
  // Serious-misconduct claims require human review before publish (§25.2, §45 rule 5).
  seriousAllegation Boolean @default(false)
  publishedAt    DateTime?
  officialResponseStatus String @default("none")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reviews        ClaimReview[]
  evidenceLinks  ClaimEvidenceLink[]
  responses      OfficialResponse[]
  corrections    Correction[]

  @@index([status])
  @@index([targetType, targetId])
  @@index([jurisdictionId])
}

model ClaimReview {
  id             String   @id @default(cuid())
  claimId        String
  claim          Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  reviewerUserId String
  reviewType     String // research|legal|safety|duplicate
  decision       String // approve|reject|needs_evidence|escalate
  rationale      String
  createdAt      DateTime @default(now())

  @@index([claimId])
}

enum RedactionStatus {
  NONE
  NEEDED
  IN_PROGRESS
  REDACTED
  APPROVED
}

model EvidenceItem {
  id                String   @id @default(cuid())
  uploaderUserId    String
  title             String
  description       String?
  evidenceType      String // pdf|image|audio|video|... (§14.2)
  // ORIGINAL and PUBLIC copies are stored separately (§14.4, §32 data separation).
  originalStorageKey String  // restricted bucket, signed access only
  publicStorageKey   String? // redacted/processed copy for public viewing
  originalHash      String?  // sha-256 of original (§14.3 chain-of-custody integrity)
  processedHash     String?
  visibility        ContentVisibility @default(OWNER_ONLY)
  verificationStatus String  @default("unverified")
  redactionStatus   RedactionStatus @default(NONE)
  legalHold         Boolean  @default(false)
  createdAt         DateTime @default(now())

  metadata          EvidenceMetadata?
  chainEvents       EvidenceChainEvent[]
  redactions        Redaction[]
  claimLinks        ClaimEvidenceLink[]
  sources           Source[]

  @@index([uploaderUserId])
  @@index([visibility])
}

model EvidenceMetadata {
  evidenceId     String  @id
  evidence       EvidenceItem @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  sourceName     String?
  sourceType     String?
  sourceDate     DateTime?
  custodian      String?
  originalFilename String?
  mimeType       String?
  fileSize       Int?
  extractedText  String? // OCR/transcript (§14.3) — never for restricted content publicly
  metadataJson   Json    @default("{}")
}

enum EvidenceRelationship {
  SUPPORTS
  PARTIALLY_SUPPORTS
  CONTRADICTS
  PROVIDES_CONTEXT
  IRRELEVANT
  INCONCLUSIVE
}

model ClaimEvidenceLink {
  id             String   @id @default(cuid())
  claimId        String
  claim          Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  evidenceId     String
  evidence       EvidenceItem @relation(fields: [evidenceId], references: [id])
  relationship   EvidenceRelationship
  strength       String   @default("unclear")
  reviewerUserId String?
  createdAt      DateTime @default(now())

  @@unique([claimId, evidenceId])
  @@index([evidenceId])
}

// Append-only chain of custody (§14.5). Never deleted.
model EvidenceChainEvent {
  id           String   @id @default(cuid())
  evidenceId   String
  evidence     EvidenceItem @relation(fields: [evidenceId], references: [id])
  eventType    String // uploaded|accessed|downloaded|redacted|reviewed|published|...
  actorUserId  String?
  occurredAt   DateTime @default(now())
  metadataJson Json     @default("{}")

  @@index([evidenceId])
}

model Redaction {
  id             String   @id @default(cuid())
  evidenceId     String
  evidence       EvidenceItem @relation(fields: [evidenceId], references: [id])
  redactedCopyKey String
  reason         String
  redactedBy     String
  approvedBy     String?
  createdAt      DateTime @default(now())

  @@index([evidenceId])
}

// ===========================================================================
// 24 OFFICIAL RESPONSE & CORRECTION (foundation items 11) — first-class (§24)
// ===========================================================================

model OfficialResponse {
  id            String   @id @default(cuid())
  claimId       String?
  claim         Claim?   @relation(fields: [claimId], references: [id])
  // Responder must be a verified official/affected party (§24). Never auto-true (§24).
  responderUserId String
  subjectType   String // claim|scorecard|official_profile
  subjectId     String
  responseType  String // context|dispute|correction_request|official_statement|appeal
  body          String
  status        String   @default("submitted")
  createdAt     DateTime @default(now())

  @@index([subjectType, subjectId])
}

model Correction {
  id          String   @id @default(cuid())
  claimId     String?
  claim       Claim?   @relation(fields: [claimId], references: [id])
  subjectType String
  subjectId   String
  description String
  correctedBy String
  visible     Boolean  @default(true) // corrections stay visible & timestamped (§24)
  createdAt   DateTime @default(now())

  @@index([subjectType, subjectId])
}

// ===========================================================================
// 28.10 SCORECARDS (§10) — missing data is NEVER zero (§10.5, §45 rule 10)
// ===========================================================================

model ScorecardMethodology {
  id               String   @id @default(cuid())
  name             String
  entityType       String // official|agency|judge|prosecutor|court
  version          String
  description      String?
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  publicDocumentUrl String?
  scorecards       Scorecard[]

  @@unique([name, version])
}

model Scorecard {
  id               String   @id @default(cuid())
  entityType       String
  entityId         String
  methodologyId    String
  methodology      ScorecardMethodology @relation(fields: [methodologyId], references: [id])
  periodStart      DateTime
  periodEnd        DateTime
  overallScore     Decimal? // null when insufficientData (§10.4) — NOT zero
  confidence       String   @default("insufficient_data")
  insufficientData Boolean  @default(true)
  publishedAt      DateTime?
  createdAt        DateTime @default(now())

  categories       ScorecardCategory[]
  appeals          ScorecardAppeal[]

  @@index([entityType, entityId])
}

model ScorecardCategory {
  id          String   @id @default(cuid())
  scorecardId String
  scorecard   Scorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  categoryName String
  score        Decimal?
  weight       Decimal
  confidence   String   @default("insufficient_data")
  explanation  String?
  metrics      ScorecardMetric[]
}

model ScorecardMetric {
  id             String   @id @default(cuid())
  categoryId     String
  category       ScorecardCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  metricName     String
  rawValue       Decimal?
  normalizedScore Decimal?
  weight         Decimal
  confidence     String   @default("insufficient_data")
}

model ScorecardAppeal {
  id             String   @id @default(cuid())
  scorecardId    String
  scorecard      Scorecard @relation(fields: [scorecardId], references: [id])
  appellantUserId String
  reason         String
  evidenceId     String?
  status         String   @default("submitted")
  decision       String?
  decidedAt      DateTime?
  createdAt      DateTime @default(now())

  @@index([scorecardId])
}

// ===========================================================================
// 28.6 PUBLIC RECORDS (§15)
// ===========================================================================

enum RecordsRequestStatus {
  DRAFT
  READY_TO_SEND
  SENT
  ACKNOWLEDGED
  CLARIFICATION_REQUESTED
  FEE_ESTIMATE_RECEIVED
  PAYMENT_NEEDED
  PROCESSING
  PARTIALLY_FULFILLED
  FULFILLED
  DENIED
  APPEALED
  CLOSED
  OVERDUE
  LITIGATION_REVIEW
}

model RecordsRequest {
  id            String   @id @default(cuid())
  creatorUserId String
  agencyId      String?
  jurisdictionId String?
  title         String
  requestText   String
  sentAt        DateTime?
  status        RecordsRequestStatus @default(DRAFT)
  feeLimit      Decimal?
  feeEstimate   Decimal?
  dueDate       DateTime?
  public        Boolean  @default(false)
  campaignId    String?
  createdAt     DateTime @default(now())

  events        RecordsRequestEvent[]
  productions   RecordsProduction[]
  denials       RecordsDenial[]

  @@index([creatorUserId])
  @@index([status])
}

model RecordsRequestEvent {
  id          String   @id @default(cuid())
  requestId   String
  request     RecordsRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  eventType   String
  eventAt     DateTime @default(now())
  description String?
  createdBy   String?
}

model RecordsProduction {
  id          String   @id @default(cuid())
  requestId   String
  request     RecordsRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  evidenceId  String?
  receivedAt  DateTime?
  description String?
}

model RecordsDenial {
  id           String   @id @default(cuid())
  requestId    String
  request      RecordsRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  reason       String
  exemption    String?
  denialDate   DateTime?
  appealStatus String?
}

// ===========================================================================
// 28.11 MODERATION, REPUTATION, AUDIT (§21, §23, §4.6)
// ===========================================================================

model ContentReport {
  id             String   @id @default(cuid())
  reporterUserId String
  contentType    String
  contentId      String
  reason         String // matches ModerationReason vocabulary (§23.3)
  details        String?
  status         String   @default("open")
  createdAt      DateTime @default(now())

  @@index([contentType, contentId])
  @@index([status])
}

model ModerationAction {
  id                String   @id @default(cuid())
  contentType       String
  contentId         String
  moderatorUserId   String
  actionType        String // limit|remove|needs_evidence|needs_redaction|legal_hold|...
  reason            String // required (§23.4, §45 rule 8)
  publicExplanation String? // published moderation reason (§23.4/§23.5)
  startsAt          DateTime @default(now())
  endsAt            DateTime?
  appeals           ModerationAppeal[]

  @@index([contentType, contentId])
}

model ModerationAppeal {
  id                 String   @id @default(cuid())
  moderationActionId String
  moderationAction   ModerationAction @relation(fields: [moderationActionId], references: [id])
  appellantUserId    String
  reason             String
  status             String   @default("submitted")
  // Reviewed by someone other than original moderator when possible (§23.6).
  reviewedBy         String?
  decision           String?
  decidedAt          DateTime?
  createdAt          DateTime @default(now())

  @@index([moderationActionId])
}

model ReputationEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dimension  String // evidence_quality|research_accuracy|civic_participation|... (§21.3)
  points     Int
  reason     String
  sourceType String?
  sourceId   String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model BotRiskEvent {
  id           String   @id @default(cuid())
  userId       String?
  deviceId     String?
  riskType     String
  riskScore    Int
  metadataJson Json     @default("{}")
  createdAt    DateTime @default(now())
}

// Append-only audit log (§28.11, §4.6, §45 rule 14/18). No update/delete in app code.
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  beforeJson  Json?
  afterJson   Json?
  ipHash      String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
}

// ===========================================================================
// 26 NOTIFICATIONS (foundation item 17)
// ===========================================================================

model Follow {
  id         String   @id @default(cuid())
  userId     String
  targetType String // jurisdiction|official|agency|case|claim|petition|campaign|...
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // new_record|claim_status_change|official_response|... (§26)
  title     String
  body      String?
  linkPath  String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
}

// ===========================================================================
// 28.7 CIVICFUND (§16) — transparent ledger; missing/pending funds never assumed
// ===========================================================================

enum CampaignStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  LIVE
  FUNDED
  ACTIVE
  AWAITING_RECORDS
  DELIVERABLE_PUBLISHED
  PARTIALLY_COMPLETED
  FAILED
  REFUNDING
  CLOSED
}

model Campaign {
  id             String   @id @default(cuid())
  creatorUserId  String
  campaignType   String // public_records|investigation|court_transparency|community_audit (§16.2)
  title          String
  description    String
  jurisdictionId String?
  goalAmount     Decimal
  status         CampaignStatus @default(DRAFT)
  approvedBy     String?
  startsAt       DateTime?
  endsAt         DateTime?
  platformFeeRate Decimal @default(0.05)
  refundPolicy   String
  createdAt      DateTime @default(now())

  milestones   CampaignMilestone[]
  contributions Contribution[]
  expenses     CampaignExpense[]
  updates      CampaignUpdate[]

  @@index([status])
}

model CampaignMilestone {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title       String
  description String?
  targetAmount Decimal?
  status      String   @default("pending")
  dueAt       DateTime?
  completedAt DateTime?
}

model Contribution {
  id               String   @id @default(cuid())
  campaignId       String
  campaign         Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contributorUserId String
  amount           Decimal
  processorFee     Decimal  @default(0)
  platformFee      Decimal  @default(0)
  status           String   @default("succeeded") // pending|succeeded|refunded|failed
  anonymousDisplay Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([campaignId])
}

model CampaignExpense {
  id                String   @id @default(cuid())
  campaignId        String
  campaign          Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  category          String
  vendor            String
  amount            Decimal
  receiptEvidenceId String?
  description       String
  status            String   @default("proposed") // proposed|approved|paid|rejected
  approvedBy        String?
  paidAt            DateTime?
  createdAt         DateTime @default(now())

  @@index([campaignId])
}

model CampaignUpdate {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  authorUserId String
  title        String
  body         String
  createdAt    DateTime @default(now())
}

// ===========================================================================
// 28.8 PETITIONS & ACTION (§17)
// ===========================================================================

model Petition {
  id            String   @id @default(cuid())
  creatorUserId String
  title         String
  requestText   String
  targetType    String
  targetId      String?
  jurisdictionId String?
  status        String   @default("draft")
  deadline      DateTime?
  signatureGoal Int?
  public        Boolean  @default(false)
  createdAt     DateTime @default(now())

  signatures    PetitionSignature[]

  @@index([status])
}

model PetitionSignature {
  id                  String   @id @default(cuid())
  petitionId          String
  petition            Petition @relation(fields: [petitionId], references: [id], onDelete: Cascade)
  userId              String
  verifiedJurisdiction String?
  displayPreference   String   @default("private") // public|private
  fraudStatus         String   @default("clear")
  signedAt            DateTime @default(now())

  // One signature per user per petition (duplicate protection, §17.3).
  @@unique([petitionId, userId])
  @@index([petitionId])
}

model ActionPlan {
  id            String   @id @default(cuid())
  creatorUserId String
  title         String
  jurisdictionId String?
  status        String   @default("draft")
  description   String?
  createdAt     DateTime @default(now())

  steps         ActionStep[]
}

model ActionStep {
  id           String   @id @default(cuid())
  actionPlanId String
  actionPlan   ActionPlan @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  sequence     Int
  actionType   String
  description  String
  dueAt        DateTime?
  status       String   @default("pending")
}

// ===========================================================================
// 28.9 INVESTIGATIONS (§20)
// ===========================================================================

model Investigation {
  id               String   @id @default(cuid())
  title            String
  researchQuestion String
  jurisdictionId   String?
  leadUserId       String
  status           String   @default("proposal") // §20.2 phases
  visibility       ContentVisibility @default(INVESTIGATION_TEAM)
  methodology      String?
  limitations      String?
  publishedAt      DateTime?
  createdAt        DateTime @default(now())

  members  InvestigationMember[]
  tasks    InvestigationTask[]
  findings InvestigationFinding[]

  @@index([status])
}

model InvestigationMember {
  id               String   @id @default(cuid())
  investigationId  String
  investigation    Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  userId           String
  role             String // lead|researcher|reviewer
  conflictDisclosure String?
  joinedAt         DateTime @default(now())

  @@unique([investigationId, userId])
}

model InvestigationTask {
  id              String   @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  title           String
  assignedTo      String?
  status          String   @default("open")
