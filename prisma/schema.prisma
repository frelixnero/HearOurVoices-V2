}

model InvestigationFinding {
  id              String   @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  title           String
  summary         String
  confidence      String   @default("unclear")
  status          String   @default("draft")
  publishedAt     DateTime?
}

// ===========================================================================
// 18/19 ELECTIONS & CANDIDATE GUIDE (§18 Replacement Tracker, §19 Vote Hub)
// Plain-language, nonpartisan comparison. Verified facts are kept separate from
// campaign claims (§18.3). Demo data is fictional (§44).
// ===========================================================================

model Election {
  id             String   @id @default(cuid())
  name           String
  jurisdictionId String?
  electionDate   DateTime
  type           String // general|primary|special|recall
  status         String   @default("upcoming") // upcoming|active|past
  description    String?
  createdAt      DateTime @default(now())

  races          Race[]

  @@index([status])
  @@index([electionDate])
}

model Race {
  id          String   @id @default(cuid())
  electionId  String
  election    Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  title       String // e.g. "Mayor of Riverbend"
  description String?
  candidates  Candidate[]
}

model Candidate {
  id            String   @id @default(cuid())
  raceId        String
  race          Race     @relation(fields: [raceId], references: [id], onDelete: Cascade)
  name          String
  party         String?
  incumbent     Boolean  @default(false)
  website       String?
  bio           String? // plain-language, from an official/campaign source
  photoGradient String   @default("linear-gradient(135deg,#123f52,#1e6d78)")

  positions     CandidatePosition[]
  prosCons      CandidateProsCon[]
}

model CandidatePosition {
  id          String  @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  topic       String // e.g. "Housing", "Police budget"
  stance      String // for|against|mixed
  summary     String // plain-language, 4th-grade reading level
  sourceUrl   String?
}

model CandidateProsCon {
  id          String  @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  kind        String // pro|con
  text        String // plain-language
}

// ===========================================================================
// STORY-SHARING PLATFORM (current product). Personal experiences shared safely,
// anonymously or publicly, moderated for safety. Reuses moderation + audit.
// ===========================================================================

enum StoryStatus {
  PUBLISHED       // live in the feed
  PENDING_REVIEW  // held by the safety scan for human review before publishing
  REMOVED         // taken down by moderation
}

model Story {
  id            String   @id @default(cuid())
  authorUserId  String?  // known to the platform even when displayed anonymously
  displayName   String   @default("Anonymous")
  anonymous     Boolean  @default(true)
  title         String?
  body          String
  topics        String[] @default([]) // topic slugs (workplace|school|...)
  hideLocation  Boolean  @default(true)
  status        StoryStatus @default(PUBLISHED)
  supportCount  Int      @default(0)
  commentCount  Int      @default(0)
  createdAt     DateTime @default(now())
  publishedAt   DateTime?

  supports      StorySupport[]
  comments      StoryComment[]

  @@index([status, publishedAt])
  @@index([authorUserId])
}

// One "heart"/support per user per story (§ dedupe).
model StorySupport {
  id        String   @id @default(cuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([storyId, userId])
  @@index([storyId])
}

model StoryComment {
  id           String   @id @default(cuid())
  storyId      String
  story        Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  authorUserId String?
  displayName  String   @default("Anonymous")
  anonymous    Boolean  @default(true)
  body         String
  status       StoryStatus @default(PUBLISHED)
  createdAt    DateTime @default(now())

  @@index([storyId])
}

// Browsable topics (Workplace, School, Healthcare, Justice, Military, Other).
model Topic {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String?
  sortOrder   Int    @default(0)
}

// Community-support directory (crisis hotlines, mental health, legal, groups).
model SupportResource {
  id          String  @id @default(cuid())
  category    String // crisis|mental_health|legal|community
  name        String
  description String
  phone       String?
  url         String?
  region      String? @default("US")
  sortOrder   Int     @default(0)
}

// ===========================================================================
// RUMORS — people post a rumor/opinion; the platform GRADES how accurate it is.
// Accuracy comes from community votes + submitted evidence, and an optional
// reviewer verdict that overrides the crowd. Default is UNVERIFIED until there is
// enough input (missing data is never treated as "true" or "false").
// ===========================================================================

enum AccuracyGrade {
  TRUE
  MOSTLY_TRUE
  MIXED
  UNVERIFIED
  MOSTLY_FALSE
  FALSE
}

enum RumorStatus {
  OPEN
  PENDING_REVIEW
  REMOVED
}

model Rumor {
  id              String   @id @default(cuid())
  submitterUserId String?
  displayName     String   @default("Anonymous")
  anonymous       Boolean  @default(true)
  text            String
  topic           String?
  status          RumorStatus @default(OPEN)
  // Cached community tallies (source of truth is the RumorVote rows).
  accurateVotes   Int      @default(0)
  inaccurateVotes Int      @default(0)
  // Optional official verdict — overrides the crowd when set.
  officialGrade   AccuracyGrade?
  officialRationale String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())

  votes    RumorVote[]
  evidence RumorEvidence[]

  @@index([status, createdAt])
}

model RumorVote {
  id        String   @id @default(cuid())
  rumorId   String
  rumor     Rumor    @relation(fields: [rumorId], references: [id], onDelete: Cascade)
  userId    String
  vote      String // accurate | inaccurate
  createdAt DateTime @default(now())

  @@unique([rumorId, userId])
  @@index([rumorId])
}

model RumorEvidence {
  id          String   @id @default(cuid())
  rumorId     String
  rumor       Rumor    @relation(fields: [rumorId], references: [id], onDelete: Cascade)
  userId      String?
  displayName String   @default("Anonymous")
  anonymous   Boolean  @default(true)
  stance      String // supports | refutes
  note        String
  url         String?
  createdAt   DateTime @default(now())

  @@index([rumorId])
}

// ===========================================================================
// INDEPENDENT JOURNALIST REPORTS — neutral, labeled, sourced reporting.
// Rules enforced in the service/validation:
//  - the report MUST be labeled by type; a RUMOR is clearly marked unverified,
//  - it MUST include a faithful written account of what was actually said,
//  - it MUST link the source (the video/article),
//  - it MUST explain why it matters,
//  - the author affirms neutrality; a loaded-language check flags editorializing.
// ===========================================================================

// Two lanes of the Community Reports feature.
enum ReportLane {
  CITIZEN     // ordinary users: tips & opinions
  JOURNALIST  // higher-trust, structured, neutral reporting
}

// Every citizen post carries one visible label so nothing looks like proven fact.
enum PostLabel {
  OPINION
  UNVERIFIED_TIP
  FIRSTHAND_ACCOUNT
  EVIDENCE_SUBMITTED
  CORRECTION_ISSUED
  VERIFIED_BY_RECORDS
  DISPROVEN
}

// Where a claim stands. Evolves over time as evidence comes in — NOT a star
// rating, and unresolved claims are never "graded" as true or false.
// (Named ReportClaimStatus to avoid colliding with the legacy civic ClaimStatus.)
enum ReportClaimStatus {
  UNREVIEWED
  UNVERIFIED
  EVIDENCE_DEVELOPING
  PARTIALLY_SUPPORTED
  VERIFIED
  DISPUTED
  DISPROVEN
  RETRACTED
}

model CommunityReport {
  id           String   @id @default(cuid())
  authorUserId String
  lane         ReportLane
  displayName  String   @default("Anonymous")
  anonymous    Boolean  @default(true)
  label        PostLabel @default(UNVERIFIED_TIP)   // citizen-lane visible label
  claimStatus  ReportClaimStatus @default(UNREVIEWED)
  title        String
  body         String
  topic        String?
  sourceUrl    String?
  // Journalist-lane structured fields (required by validation for JOURNALIST).
  exactClaim       String? // the exact claim being examined
  videoShows       String? // what the video directly shows
  videoDoesntProve String? // what it does NOT prove
  confirmedParts   String? // which parts are confirmed / unconfirmed
  origin           String? // where the information originated
  whyImportant     String? // why it matters to the community
  affectedParty    String? // the person/agency named
  affectedResponse String? // their response, or "did not respond"
  conflicts        String? // disclosed political/financial/personal conflicts
  neutralityFlags  String[] @default([]) // loaded-language flags (transparency)
  status       StoryStatus @default(PUBLISHED) // publish state (reuses enum)
  createdAt    DateTime @default(now())
  publishedAt  DateTime?

  corrections  CommunityReportCorrection[]
  statusEvents ClaimStatusEvent[]

  @@index([lane, status, publishedAt])
  @@index([authorUserId])
  @@index([claimStatus])
}

model CommunityReportCorrection {
  id          String   @id @default(cuid())
  reportId    String
  report      CommunityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  note        String
  correctedBy String
  voluntary   Boolean  @default(true) // voluntary correction counts positively toward the record
  createdAt   DateTime @default(now())

  @@index([reportId])
}

// ===========================================================================
// CIVIC NEWS + PUBLIC JUDGMENT — main-page feed of authority actions (local /
// state / nation). Each item is neutral facts + evidence + pros/cons + a process
// check; the VERDICT (Good/Bad/Needs Info) comes from PUBLIC votes, not the
// platform, so nothing is editorialized or asserted as fact by us.
// ===========================================================================

enum CivicScope {
  LOCAL
  STATE
  NATION
}

enum CivicVerdict {
  GOOD_MOVE
  BAD_MOVE
  NEEDS_INFO
}

enum EvidenceLabel {
  DOCUMENTED
  RECORDED
  MISSING
  UNVERIFIED
}

// One engine for every authority — you only change the evidence you pull.
enum AuthorityCategory {
  POLICE
  LAWMAKER
  JUDGE
  COUNCIL
  AGENCY
  COMMITTEE
  OVERSIGHT
  EXECUTIVE
  OTHER
}

model CivicNews {
  id           String   @id @default(cuid())
  scope        CivicScope
  authority    AuthorityCategory @default(OTHER)
  title        String
  actorType    String   // City Council | Mayor | Police | Governor | Congress | President | Agency…
  actorName    String?  // optional; kept factual
  actorKey     String?  // normalized actor id for history/pattern tracking
  jurisdiction String?  // "Riverbend, ZZ" | "State of Columbia" | "U.S. House"
  actionType   String?  // congress_debate | cabinet_appointment | town_meeting | committee_hearing | agency_action | city_council | other — drives the plain-language module
  whatHappened String   // plain-language facts (action summary)
  whyItMatters String   // why the public should care
  nextStep     String?  // "What happens next" — the next step in the process
  pros         String[] @default([]) // sourced tradeoffs (for)
  cons         String[] @default([]) // sourced tradeoffs (against)
  alternatives String[] @default([]) // better options they could have taken
  powerMap     String[] @default([]) // who could have stopped/changed it ("Mayor — could have vetoed")
  // Process check — factual yes/no/unknown (null = unknown).
  recordedVote    Boolean?
  publicNotice    Boolean?
  amendmentPosted Boolean?
  meetingRecorded Boolean?
  publicComment   Boolean?
  procedureLegal  Boolean?
  impactLevel  Int      @default(0) // 0–5
  // Cached public-judgment tallies (source of truth is CivicVote rows).
  goodVotes    Int      @default(0)
  badVotes     Int      @default(0)
  infoVotes    Int      @default(0)
  status       StoryStatus @default(PUBLISHED)
  createdBy    String?  // staff/journalist who published it
  createdAt    DateTime @default(now())
  publishedAt  DateTime?

  sources CivicSource[]
  votes   CivicVote[]

  @@index([scope, status, publishedAt])
  @@index([authority])
  @@index([actorKey])
}

model CivicSource {
  id        String   @id @default(cuid())
  newsId    String
  news      CivicNews @relation(fields: [newsId], references: [id], onDelete: Cascade)
  label     EvidenceLabel
  title     String
  url       String?
  createdAt DateTime @default(now())

  @@index([newsId])
}

// One public judgment per user per item — a verdict AND a required reason.
model CivicVote {
  id        String   @id @default(cuid())
  newsId    String
  news      CivicNews @relation(fields: [newsId], references: [id], onDelete: Cascade)
  userId    String
  verdict   CivicVerdict
  reason    String
  createdAt DateTime @default(now())

  @@unique([newsId, userId])
  @@index([newsId])
}

// ===========================================================================
// JUSTICE VAULT — spotlight cases built to be remembered. Facts-only spine,
// legal-safe wording (state charges/verdicts exactly; never label someone a
// "killer" unless legally convicted; criticize actions, not identity). Demo data
// is fictional; real cases require verified public records + legal review.
// ===========================================================================

enum CaseStatus {
  ACTIVE
  UNDER_REVIEW
  HISTORICAL
}

model JusticeCase {
  id                String   @id @default(cuid())
  victimName        String
  victimAge         Int?
  location          String?
  dateOfIncident    DateTime?
  caseType          String   // Unsolved | Controversial Verdict | System Failure | …
  // Two-sentence memory lock — re-graspable in seconds.
  memoryLockPrimary String   // what happened (one sentence)
  memoryLockFailure String   // what failed (one sentence)
  status            CaseStatus @default(ACTIVE)
  justiceGapScore   Int      @default(0) // 0–100
  spotlightLevel    Int      @default(0) // 0 normal · 3 = highest ("never forget")
  // Human-first profile.
  favoriteActivities String?
  personalityWords   String[] @default([])
  whatWasLost        String?
  anchorPhrases      String[] @default([]) // memory-boost phrases reused everywhere
  // Structured detail stored as JSON arrays (display-only, no querying needed):
  timeline  Json @default("[]") // [{date,label,description,scoreTag?,sourceUrl?}]
  actions   Json @default("[]") // [{actorType,actorName?,description,scoreTag,impactWeight}]
  questions Json @default("[]") // [{questionText,targetAuthority,status}]
  flags     Json @default("[]") // [{flag,reason}] contradiction markers
  sources   Json @default("[]") // [{label,title,url?}]
  publishState StoryStatus @default(PUBLISHED)
  createdBy   String?
  createdAt   DateTime @default(now())
  publishedAt DateTime?

  @@index([spotlightLevel, publishState])
  @@index([status])
}

// The Honor Vault — a permanent, factual record of military service and sacrifice.
// Counterpart to the Justice Vault. Honor/tribute content: respectful, sourced,
// no accusations. "Never forget" by design.
enum HonorCategory {
  FALLEN       // died in service
  COMBAT       // Purple Heart, Silver Star, Medal of Honor, etc.
  LIFESAVING   // saved lives (in service or as a veteran)
  COMMUNITY    // service to community after uniform
  LEGACY       // long life, lasting impact
}

model HonorHero {
  id                 String   @id @default(cuid())
  heroName           String
  rank               String?
  branch             String?  // Army | Navy | Marines | Air Force | Coast Guard | Space Force
  category           HonorCategory @default(FALLEN)
  homeState          String?
  conflictOrEra      String?  // "Afghanistan", "Vietnam", "WWII", "Peacetime"
  // Two-sentence memory lock — imprints instantly.
  memoryLockPrimary  String   // what they did
  memoryLockSacrifice String  // what they gave / endured
  serviceSummary     String?  // <=25 words
  momentOfCourage    String?  // the defining moment
  legacyImpact       String?  // what they changed / who they helped
  medals             String[] @default([]) // Purple Heart, Bronze Star, Medal of Honor…
  memoryPhrases      String[] @default([]) // short sticky phrases
  chainOfInfluence   String[] @default([]) // unit, mission, community, family, future
  quotes             Json     @default("[]") // [{quote, attribution}]
  keyDates           Json     @default("[]") // [{label, date}] for the Never-Forget resurfacing
  honorScore         Int      @default(0) // DEPRECATED — replaced by Remembrance (candles + tributes)
  candles            Int      @default(0) // remembrance tokens left at the resting place — these accumulate,
  coins              Int      @default(0) // never reset, so the memorial grows with every visit.
  flags              Int      @default(0)
  stones             Int      @default(0)
  flowers            Int      @default(0)
  spotlightLevel     Int      @default(0) // 0 normal · 3 = highest ("never forget")
  publishState       StoryStatus @default(PUBLISHED)
  createdBy          String?
  createdAt          DateTime @default(now())
  publishedAt        DateTime?

  tributes           HonorTribute[]

  @@index([spotlightLevel, publishState])
  @@index([category])
}

// The Tribute Wall — messages of remembrance from family, service members, and
// community. Moderated: nothing appears on a memorial until approved.
model HonorTribute {
  id           String    @id @default(cuid())
  heroId       String
  hero         HonorHero @relation(fields: [heroId], references: [id], onDelete: Cascade)
  displayName  String    @default("Anonymous")
  relationship String?   // "Daughter", "Fellow soldier", "Neighbor"…
  message      String
  status       StoryStatus @default(PENDING_REVIEW)
  createdAt    DateTime  @default(now())
  publishedAt  DateTime?

  @@index([heroId, status])
  @@index([status, createdAt])
}

// Append-only trail of claim-status changes (who moved it, and why).
model ClaimStatusEvent {
  id             String   @id @default(cuid())
  reportId       String
  report         CommunityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  fromStatus     ReportClaimStatus
  toStatus       ReportClaimStatus
  rationale      String
  reviewerUserId String
  createdAt      DateTime @default(now())

  @@index([reportId])
}

// AI-surfaced research leads (e.g. from Grok Live Search over X/news/web). These
// are UNVERIFIED tips for staff triage — never published automatically. A human
// verifies against primary sources and creates real content the normal way.
enum LeadStatus {
  NEW
  DISMISSED
}

model Lead {
  id           String     @id @default(cuid())
  query        String                       // what was searched
  jurisdiction String?
  title        String
  summary      String
  citations    Json       @default("[]")    // [{url, title?}] source links the model cited
  source       String     @default("grok")
  status       LeadStatus @default(NEW)
  createdBy    String?
  createdAt    DateTime   @default(now())

  @@index([status, createdAt])
}

// Web-push subscriptions for red-flag / breaking-news alerts. One row per
// browser/device that opted in. No account required — anonymous by endpoint.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// A ledger of completed payments, recorded from verified Stripe webhooks.
// No card data (Stripe holds that); minimal fields for records/receipts.
model Donation {
  id            String   @id @default(cuid())
  kind          String   @default("donation") // donation | membership
  amountCents   Int
  currency      String   @default("usd")
  stripeSession String   @unique
  email         String?  // billing email from Stripe, for receipts/thank-yous
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

// Anonymous whistleblower tips. We store NO identity, NO IP, NO user-agent —
// only an encrypted message (AES-256-GCM at rest) readable by the small review
// team. Text-only by design: files are the biggest de-anonymization risk.
enum TipStatus {
  NEW
  REVIEWED
  ARCHIVED
}

model WhistleblowerTip {
  id         String    @id @default(cuid())
  ciphertext String    // base64(iv + authTag + AES-256-GCM ciphertext)
  category   String?
  status     TipStatus @default(NEW)
  createdAt  DateTime  @default(now())

  @@index([status, createdAt])
}

// Verified legislative records ingested from a public data source (OpenStates v3).
// This is factual public-record data only — the source of truth is the API; we
// cache it so pages are fast and Red Flags can be derived from the documented record.
model Bill {
  id                      String   @id @default(cuid())
  source                  String   @default("openstates") // "openstates" | "legiscan"
  externalId              String   @unique                // "openstates:ocd-bill/…" | "legiscan:123456"
  jurisdiction            String                    // "Texas", "United States"
  session                 String
  identifier              String                    // "HB 100"
  title                   String
  classification          String[] @default([])     // ["bill"], ["resolution"]…
  subjects                String[] @default([])
  latestActionDate        String?
  latestActionDescription String?
  sponsors                Json     @default("[]")    // [{name, classification, primary}]
  actions                 Json     @default("[]")    // [{date, description, classification[]}]
  votes                   Json     @default("[]")    // [{date, motion, result, yes, no, other}]
  sources                 Json     @default("[]")    // [{url, note}]
  sourceUrl               String?                    // canonical record URL on the source site
  redFlags                String[] @default([])      // cached, derived only from the documented record
  firstSyncedAt           DateTime @default(now())
  lastSyncedAt            DateTime @default(now())

  @@index([jurisdiction, session])
  @@index([lastSyncedAt])
  sponsorLinks BillSponsor[]
}

// Normalized bill<->sponsor links so we can build an official's LEGISLATIVE RECORD
// (their sponsored bills) from verified data. Names are attached to documented
// facts only — never to rumors.
model BillSponsor {
  id       String  @id @default(cuid())
  billId   String
  bill     Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  name     String
  nameKey  String              // slugified name for grouping/lookup
  role     String?
  primary  Boolean @default(false)

  @@index([nameKey])
  @@index([billId])
}
